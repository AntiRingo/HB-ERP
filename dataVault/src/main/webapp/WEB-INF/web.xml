<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        　　<servlet-name>event-collector</servlet-name>
        　　<servlet-class>com.hongbang.web.servlet.GreyStartServlet</servlet-class>
        　　<load-on-startup>5</load-on-startup>
    </servlet>
    <servlet-mapping>
        　　<servlet-name>event-collector</servlet-name>
        　　<url-pattern>/event-collect</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>15</session-timeout>
        <!-- 配置会话跟踪模式（如 URL 重写） -->
        <tracking-mode>COOKIE</tracking-mode>

    </session-config>

    <context-param>
        <param-name>dailyTaskEnabled</param-name>
        <param-value>true</param-value>
    </context-param>
<!--    <listener>-->
<!--        <listener-class>com.hongbang.filter.SessionListener</listener-class>-->
<!--    </listener>-->

</web-app>
