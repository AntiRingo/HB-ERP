<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hongbang.mapper.FinSortMapper">
    <!--    excel表添加分类-->
    <insert id="addSortExcel" parameterType="sort">
        insert into fin_sort (id, parent_id, fin_sort_name, fin_sort_level, fin_sort_description, fin_sort_code)
        values (null,#{parentId},#{finSortName},#{finSortLevel},#{finSortDescription},#{finSortCode});
        <selectKey  keyProperty="id" order="AFTER" resultType="java.lang.Integer" >
            select last_insert_id();
        </selectKey>
    </insert>


    <!--    //循环更新编码-->
    <update id="updateCodes" parameterType="java.util.List">

        <foreach collection="finSorts" index="index" item="finSorts" separator=";">
            update fin_sort
            <set>
                fin_sort.fin_sort_code=#{finSorts.finSortCode,jdbcType=VARCHAR}
            </set>
            where fin_sort.id=#{finSorts.id,jdbcType=INTEGER}
        </foreach>
    </update>

</mapper>